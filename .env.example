# Supabase PostgreSQL connection string (gunakan Transaction/Session Pooler URI dari Supabase -> Connect)
# Kosongkan saat lokal jika ingin tetap memakai SQLite (server/data/moneta.db)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Secret acak untuk menandatangani cookie sesi login (isi string acak panjang, mis. 32+ karakter)
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
